{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "wp:lapis_halo",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/wp_glow"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "variable.halo_angle = Math.random(0, 360);"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 6
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "offset": [0, 0, 0]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1.0
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "Math.cos(variable.halo_angle + variable.particle_random_1 * 60 + variable.particle_age * 360) * 0.85",
          "0.15 + variable.particle_random_2 * 0.5 + Math.sin(variable.particle_age * 540 + variable.particle_random_3 * 360) * 0.08",
          "Math.sin(variable.halo_angle + variable.particle_random_1 * 60 + variable.particle_age * 360) * 0.85"
        ],
        "direction": [0, 0, 0]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.10 + Math.sin(variable.particle_age * 180) * 0.06",
          "0.10 + Math.sin(variable.particle_age * 180) * 0.06"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 8,
          "uv": [0, 0],
          "uv_size": [8, 8]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [0.30, 0.55, 1.0, 1.0]
      }
    }
  }
}
