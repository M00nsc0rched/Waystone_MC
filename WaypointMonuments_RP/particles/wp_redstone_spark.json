{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "wp:redstone_spark",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/wp_glow"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 4
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_disc": {
        "radius": 0.35,
        "plane_normal": [0, 1, 0],
        "direction": [0, 1, 0]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "Math.random(0.6, 1.1)"
      },
      "minecraft:particle_initial_speed": "Math.random(0.6, 1.2)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "Math.sin(variable.particle_age * 900 + variable.particle_random_1 * 360) * 0.6",
          -0.4,
          "Math.cos(variable.particle_age * 900 + variable.particle_random_2 * 360) * 0.6"
        ],
        "linear_drag_coefficient": 1.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.09 * (1.0 - variable.particle_age / variable.particle_lifetime)",
          "0.09 * (1.0 - variable.particle_age / variable.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 8,
          "texture_height": 8,
          "uv": [0, 0],
          "uv_size": [8, 8]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [1.0, 0.22, 0.12, 1.0]
      }
    }
  }
}
