{
  "format_version": "1.21.100",
  "minecraft:block": {
    "description": {
      "identifier": "wp:waypoint",
      "menu_category": {
        "category": "construction"
      },
      "states": {
        "wp:mode": ["none", "teleport", "enchant", "ward"]
      }
    },
    "components": {
      "wp:waypoint_menu": {},
      "minecraft:tick": {
        "interval_range": [10, 10],
        "looping": true
      },
      "minecraft:movable": {
        "movement_type": "immovable"
      },
      "minecraft:collision_box": {
        "origin": [-6, 0, -6],
        "size": [12, 16, 12]
      },
      "minecraft:selection_box": {
        "origin": [-6, 0, -6],
        "size": [12, 16, 12]
      },
      "minecraft:geometry": "geometry.wp_waypoint",
      "minecraft:material_instances": {
        "*": {
          "texture": "wp_waypoint",
          "render_method": "opaque"
        },
        "rim": {
          "texture": "wp_waypoint",
          "render_method": "opaque"
        }
      },
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 3600.0,
        "item_specific_speeds": [
          { "item": "minecraft:diamond_pickaxe", "destroy_speed": 1.5 },
          { "item": "minecraft:netherite_pickaxe", "destroy_speed": 1.2 }
        ]
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 1200.0
      },
      "minecraft:light_emission": 7,
      "minecraft:light_dampening": 0,
      "minecraft:map_color": "#3B3547"
    },
    "permutations": [
      {
        "condition": "q.block_state('wp:mode') == 'teleport'",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "wp_waypoint",
              "render_method": "opaque"
            },
            "rim": {
              "texture": "wp_waypoint_rim_red",
              "render_method": "opaque",
              "ambient_occlusion": false,
              "face_dimming": false
            }
          },
          "minecraft:light_emission": 12
        }
      },
      {
        "condition": "q.block_state('wp:mode') == 'enchant'",
        "components": {
          "minecraft:light_emission": 12
        }
      }
    ]
  }
}
